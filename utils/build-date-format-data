# Builds the date-format Swift data (a single DateFormatData.swift of `static
# let` constant tables) for the _FoundationInternationalizationData library from
# DateFormatData.json.
#
# Usage:
#   build-date-format-data [--locales=en,es,...] [--fallback=en_001] \
#                          [--input=path/to/DateFormatData.json] \
#                          [--output=path/to/DateFormatData.swift]
#
# --locales: comma-separated subset of locales to include (default: all).
# --fallback: locale used for an identifier that resolves to none of the
#             included locales; auto-included in the locale set. Without it,
#             the runtime uses root.
# --input: path to the JSON intermediate (default: in the source tree).
# --output: path to the generated Swift file (default: in the source tree).

set -eu

declare -r commandName="$(basename "$0")"
declare -r utilsDir="$(cd "$(dirname "$0")" && pwd)"
declare -r foundationRepoDir="$(cd "${utilsDir}/.." && pwd)"
declare -r dataDir="${foundationRepoDir}/Sources/_FoundationInternationalizationData"
declare -r inputDefault="${foundationRepoDir}/Sources/FoundationInternationalization/Formatting/DateFormatData.json"
declare -r outputSwiftDefault="${dataDir}/DateFormatData.swift"

INPUT="${INPUT:-${inputDefault}}"
OUTPUT_SWIFT="${OUTPUT_SWIFT:-${outputSwiftDefault}}"
LOCALES="${LOCALES:-}"
FALLBACK="${FALLBACK:-}"

for arg in "$@"; do
  case "$arg" in
    --locales=*)       LOCALES="${arg#--locales=}" ;;
    --fallback=*)      FALLBACK="${arg#--fallback=}" ;;
    --input=*)         INPUT="${arg#--input=}" ;;
    --output=*)        OUTPUT_SWIFT="${arg#--output=}" ;;
    --help|-h)
      echo "Usage: ${commandName} [--locales=en,es,...] [--fallback=en_001] [--input=path] [--output=path]" 1>&2
      exit 0
      ;;
    *)
      echo "error: unknown argument: ${arg}" 1>&2
      echo "Try --help." 1>&2
      exit 1
      ;;
  esac
done

if [[ ! -f "${INPUT}" ]]; then
  echo "error: input JSON not found at ${INPUT}" 1>&2
  echo "Run utils/update-date-format-data first to generate it from CLDR XML." 1>&2
  exit 1
fi

echo "Building date-format data" 1>&2
echo "  from:    ${INPUT}" 1>&2
echo "  output:  ${OUTPUT_SWIFT}" 1>&2
if [[ -n "${LOCALES}" ]]; then
  echo "  locales: ${LOCALES} (+ root${FALLBACK:+, ${FALLBACK}})" 1>&2
else
  echo "  locales: all" 1>&2
fi
echo "  fallback: ${FALLBACK:-root}" 1>&2

# Compile the schema, the shared locale fallback, and the impl as one module
# and run the result. Building a real module with swiftc (rather than piping
# the files through `swift` in immediate mode) keeps compilation deterministic
# and makes diagnostics point at the original files with correct line numbers.
# `-parse-as-library` lets the impl's `@main` provide the entry point instead
# of top-level script code.
bindir=$(mktemp -d -t "${commandName}.XXXXXX")
trap 'rm -rf "${bindir}"' EXIT
tool="${bindir}/${commandName}"
swiftc -parse-as-library \
    "${utilsDir}/date-format-data-schema.swift" \
    "${utilsDir}/cldr-locale-fallback.swift" \
    "${utilsDir}/${commandName}-impl.swift" \
    -o "${tool}"

env LOCALES="${LOCALES}" FALLBACK="${FALLBACK}" INPUT="${INPUT}" OUTPUT_SWIFT="${OUTPUT_SWIFT}" \
  "${tool}"

echo "Done." 1>&2
