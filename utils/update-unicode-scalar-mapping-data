# This is a shell script that generates a Swift source code file which contains
# the Unicode tables behind the case, diacritic and width options of string
# comparison and search:
# - full case folding (status C and F in CaseFolding.txt);
# - the base scalar of each canonical decomposition (UnicodeData.txt);
# - the compatibility decomposition of U+FF00..<U+FFEF (UnicodeData.txt).
#
# Keep unicodeVersion equal to the Unicode version of the standard library,
# so these options agree with `Unicode.Scalar.Properties`.
#
# The script downloads CaseFolding.txt and UnicodeData.txt from unicode.org.
# To use local copies, set the UCD_PATH environment variable to the directory
# that contains them.

set -eu

declare -r commandName="$(basename "$0")"
declare -r utilsDir="$(cd "$(dirname "$0")" && pwd)"
declare -r foundationRepoDir="$(cd "${utilsDir}/.." && pwd)"
declare -r targetSwiftFileRelativePath="Sources/FoundationEssentials/String/UnicodeScalarMappingData.swift"
declare -r unicodeVersion="17.0.0"

declare -r copyrightYear=$(
  currentYear=$(date +%Y)
  if [[ $currentYear -eq 2026 ]]; then
    echo 2026
  else
    echo 2026-${currentYear}
  fi
)
declare -r swiftLicenseHeader="
//===----------------------------------------------------------------------===//
//
// This source file is part of the Swift.org open source project
//
// Copyright (c) ${copyrightYear} Apple Inc. and the Swift project authors
// Licensed under Apache License v2.0 with Runtime Library Exception
//
// See https://swift.org/LICENSE.txt for license information
// See https://swift.org/CONTRIBUTORS.txt for the list of Swift project authors
//
//===----------------------------------------------------------------------===//
"
declare -r warningComment="
// WARNING: DO NOT EDIT THIS FILE DIRECTLY.
//          This is auto-generated by \`${commandName}\`
//          from version ${unicodeVersion} of the Unicode Character Database.
"

echo "Generating Swift source code from ${UCD_PATH:-version ${unicodeVersion} on unicode.org}..." 1>&2
declare generatedCode
generatedCode=$(
  echo "${swiftLicenseHeader##$'\n'}"
  echo "${warningComment##$'\n'}"
  swift -D PRINT_CODE "${utilsDir}/${commandName}-impl.swift" "${unicodeVersion}" "${UCD_PATH:-}"
)

echo "Writing the code to '${targetSwiftFileRelativePath}'..." 1>&2
echo "$generatedCode" >"${foundationRepoDir}/${targetSwiftFileRelativePath}"

echo "Done." 1>&2
